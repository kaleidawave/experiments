[package]
name = "rust-type-sizes"
description = "parsing for '-Zprint-type-sizes'"
version = "0.0.1"
edition = "2024"
authors = ["Ben <kaleidawave@gmail.com>"]
license = "MIT"
keywords = ["rust", "type-sizes", "tool"]
repository = "https://github.com/kaleidawave/experiments"

[dependencies]

[lib]
path = "lib.rs"

[[bin]]
name = "rust-type-sizes"
path = "main.rs"
